{
  "system": {
    "name": "studio-owncast",
    "timezone": "America/Denver",
    "updateChannel": "stable"
  },
  "sources": [
    {
      "id": "cam-host",
      "name": "Host Camera",
      "kind": "local_video",
      "deviceRef": "usb-046d_0825-hostcam"
    },
    {
      "id": "guest-1",
      "name": "Guest Slot 1",
      "kind": "network_ingest",
      "protocols": ["rtmp", "srt"],
      "publishUrl": "srt://bitriver.local:8890?streamid=publish:guest-1"
    },
    {
      "id": "lower-third",
      "name": "Show Overlay",
      "kind": "browser_source",
      "deviceRef": "https://overlays.bitriver.local/show/interview-lower-third"
    }
  ],
  "scenes": [
    {
      "id": "host-cam",
      "name": "Host Camera",
      "sources": ["cam-host", "mic-host", "lower-third"]
    },
    {
      "id": "split-guest",
      "name": "Host + Guest",
      "sources": ["cam-host", "guest-1", "mic-host", "lower-third"]
    }
  ],
  "audio": {
    "channels": [
      {
        "id": "mic-host",
        "name": "Host Mic",
        "deviceRef": "usb-focusrite-2i2-input-1"
      }
    ]
  },
  "destination": {
    "mode": "owncast",
    "targetLabel": "Owncast",
    "targetUrl": "rtmp://127.0.0.1:1935/live"
  },
  "recording": {
    "container": "mkv",
    "path": "/data/recordings/program"
  },
  "owncast": {
    "enabled": true,
    "publicUrl": "http://bitriver.local:8081"
  },
  "mediaRouter": {
    "localIngestPath": "program-live",
    "localPreviewPath": "program-preview",
    "recordingPath": "/data/recordings/program",
    "publishDestinations": [
      {
        "id": "primary-rtmp",
        "name": "Owncast",
        "protocol": "rtmp",
        "targetUrl": "rtmp://127.0.0.1:1935/live",
        "enabled": true
      }
    ],
    "webrtcPreviewEnabled": true
  }
}
