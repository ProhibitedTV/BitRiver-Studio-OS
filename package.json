    "smoke": "powershell -ExecutionPolicy Bypass -File scripts/smoke.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.13.14",
    "@types/react": "^18.3.12",
