    "@vitejs/plugin-react-swc": "^3.8.0",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0",
    "vite": "^5.4.17"
