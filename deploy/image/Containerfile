ARG FEDORA_BOOTC_IMAGE=quay.io/fedora/fedora-bootc@sha256:5f2947d685c24029b2eb4e1f0634dc4ac06116a88d9dd93da4b5571b2f0e28e1
ARG GO_BUILDER_IMAGE=docker.io/library/golang:1.22-bookworm@sha256:3d699e4d15d0f8f13c9195c0632a16702b8cbdece2955af1c23b37ae5d55a253
ARG NODE_BUILDER_IMAGE=docker.io/library/node:22-bookworm@sha256:e13726ca604184d7a91fcacab1fc09eefd642dc28e79ac34e85540dd93b78cfb
FROM ${GO_BUILDER_IMAGE} AS api-build

WORKDIR /src

COPY go.work ./
COPY apps/control-api/go.mod apps/control-api/go.mod
COPY apps/control-api apps/control-api

RUN cd apps/control-api \
  && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/bitriverd \
    ./cmd/bitriverd \
  && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/bitriver-hw-report \
    ./cmd/bitriver-hw-report \
  && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/bitriver-operator-key \
    ./cmd/bitriver-operator-key

FROM ${NODE_BUILDER_IMAGE} AS ui-build

WORKDIR /src

COPY package.json tsconfig.base.json eslint.config.mjs ./
COPY apps/control-ui/package.json apps/control-ui/package.json
COPY packages/shared/package.json packages/shared/package.json

RUN npm install

COPY apps/control-ui apps/control-ui
COPY packages/shared packages/shared

RUN npm run build --workspace @bitriver/shared \
  && npm run build --workspace @bitriver/control-ui

# All three image stages are pinned to immutable manifest digests.
FROM ${FEDORA_BOOTC_IMAGE}

ARG BITRIVER_SOURCE_REV=unknown
LABEL org.opencontainers.image.source="https://github.com/ProhibitedTV/BitRiver-Studio-OS" \
  org.opencontainers.image.revision="${BITRIVER_SOURCE_REV}"

ARG MEDIAMTX_TARBALL_URL
ARG MEDIAMTX_SHA256
ARG OWNCAST_ZIP_URL
ARG OWNCAST_SHA256

RUN test -n "${MEDIAMTX_TARBALL_URL}" \
  && test -n "${MEDIAMTX_SHA256}" \
  && test -n "${OWNCAST_ZIP_URL}" \
  && test -n "${OWNCAST_SHA256}"

RUN dnf -y install \
    alsa-utils \
    avahi \
    chromium \
    curl \
    ffmpeg \
    jq \
    obs-studio \
    openssh-server \
    openssl \
    pciutils \
    pipewire \
    systemd-networkd \
    sway \
    sudo \
    tar \
    unzip \
    v4l-utils \
    wireplumber \
    xorg-x11-server-Xwayland \
  && dnf clean all

# Fail closed on asset changes, then extract the *correct* upstream formats.
RUN curl -fL --retry 3 --proto '=https' --tlsv1.2 "${MEDIAMTX_TARBALL_URL}" -o /tmp/mediamtx.tar.gz \
  && printf '%s  %s\n' "${MEDIAMTX_SHA256}" /tmp/mediamtx.tar.gz | sha256sum -c - \
  && tar -xzf /tmp/mediamtx.tar.gz -C /usr/local/bin mediamtx \
  && chmod 0755 /usr/local/bin/mediamtx \
  && rm -f /tmp/mediamtx.tar.gz

RUN mkdir -p /opt/owncast \
  && curl -fL --retry 3 --proto '=https' --tlsv1.2 "${OWNCAST_ZIP_URL}" -o /tmp/owncast.zip \
  && printf '%s  %s\n' "${OWNCAST_SHA256}" /tmp/owncast.zip | sha256sum -c - \
  && unzip -q /tmp/owncast.zip -d /opt/owncast \
  && test -f /opt/owncast/owncast \
  && chmod 0755 /opt/owncast/owncast \
  && ln -sf /opt/owncast/owncast /usr/local/bin/owncast \
  && rm -f /tmp/owncast.zip

COPY --from=api-build /out/bitriverd /usr/local/bin/bitriverd
COPY --from=api-build /out/bitriver-hw-report /usr/local/bin/bitriver-hw-report
COPY --from=api-build /out/bitriver-operator-key /usr/local/bin/bitriver-operator-key
COPY --from=ui-build /src/apps/control-ui/dist /usr/local/share/bitriver/control-ui

COPY deploy/systemd/ /usr/lib/systemd/system/
COPY deploy/image/rootfs-overlay/ /

# bootc treats the image root as immutable. Redirect /data to persistent
# /var storage before firstboot initializes recordings and local assets.
RUN ln -s /var/lib/bitriver/data /data

RUN chmod +x /usr/local/bin/bitriverd /usr/local/bin/bitriver-hw-report /usr/local/bin/bitriver-operator-key \
  && chmod +x /usr/local/libexec/bitriver/*.sh \
  && systemctl enable bitriver.target systemd-networkd.service sshd.service \
  && bootc container lint

CMD ["/sbin/init"]
