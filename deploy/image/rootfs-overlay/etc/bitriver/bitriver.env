BITRIVER_HTTP_ADDR=127.0.0.1:8080
BITRIVER_UI_DIR=/usr/local/share/bitriver/control-ui
BITRIVER_OPERATOR_CREDENTIALS_PATH=/var/lib/bitriver/bootstrap/admin-credentials.json
BITRIVER_ASSET_LIBRARY_DIR=/data/creator-assets/assets
BITRIVER_STATE_DIR=/var/lib/bitriver
BITRIVER_BOOTSTRAP_DIR=/var/lib/bitriver/bootstrap
BITRIVER_CONFIG_DIR=/var/lib/bitriver/config
BITRIVER_HARDWARE_DIR=/var/lib/bitriver/hardware
BITRIVER_UPDATE_DIR=/var/lib/bitriver/update
BITRIVER_SETUP_STATUS_PATH=/var/lib/bitriver/bootstrap/setup-status.json
BITRIVER_INITIAL_CONFIG_PATH=/var/lib/bitriver/config/active.json
BITRIVER_HEALTH_STATUS_PATH=/run/bitriver/health/summary.json
BITRIVER_UPDATE_STATUS_PATH=/var/lib/bitriver/update/status.json
BITRIVER_MEDIAMTX_CONFIG=/etc/mediamtx/mediamtx.yml
BITRIVER_MEDIAMTX_DESTINATIONS_PATH=/etc/bitriver/mediamtx-destinations.json
BITRIVER_WAYLAND_DISPLAY=wayland-1
BITRIVER_RUNTIME_DIR=/run/bitriver/studio
BITRIVER_RECORDING_PATH=/data/recordings
BITRIVER_HEALTH_INTERVAL_SECONDS=15
BITRIVER_UPDATE_POLL_SECONDS=60
