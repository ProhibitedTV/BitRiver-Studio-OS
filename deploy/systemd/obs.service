[Unit]
StartLimitIntervalSec=120
StartLimitBurst=4
Description=OBS production engine
After=bitriver-kiosk.service bitriver-firstboot.service
Requires=bitriver-kiosk.service bitriver-firstboot.service
PartOf=bitriver.target

[Service]
Type=simple
User=studio
Group=studio
EnvironmentFile=-/etc/bitriver/bitriver.env
ExecCondition=/usr/local/libexec/bitriver/display-attached.sh
ExecStartPre=/usr/local/libexec/bitriver/wait-wayland.sh
ExecStart=/usr/local/libexec/bitriver/start-obs.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ReadWritePaths=/data/recordings /run/bitriver

[Install]
WantedBy=bitriver.target
