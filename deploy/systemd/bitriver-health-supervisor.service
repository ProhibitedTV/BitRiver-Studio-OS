[Unit]
StartLimitIntervalSec=0
Description=BitRiver liveness and degraded-mode supervisor
After=bitriver-control-api.service mediamtx.service bitriver-update-agent.service
Requires=bitriver-control-api.service mediamtx.service bitriver-update-agent.service
PartOf=bitriver.target

[Service]
Type=simple
EnvironmentFile=-/etc/bitriver/bitriver.env
ExecStart=/usr/local/libexec/bitriver/health-supervisor.sh
Restart=always
RestartSec=3

[Install]
WantedBy=bitriver.target
