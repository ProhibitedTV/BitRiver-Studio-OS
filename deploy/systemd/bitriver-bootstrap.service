[Unit]
Description=BitRiver bootstrap and runtime directory initialization
After=local-fs.target systemd-tmpfiles-setup.service
Before=bitriverd.service mediamtx.service owncast.service obs.service bitriver-kiosk.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/bitriver/bootstrap.sh
RemainAfterExit=yes

[Install]
WantedBy=bitriver.target
