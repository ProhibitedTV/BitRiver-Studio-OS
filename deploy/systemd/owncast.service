[Unit]
Description=Owncast downstream destination
After=network-online.target bitriver-firstboot.service
Requires=bitriver-firstboot.service
PartOf=bitriver.target
ConditionPathExists=/opt/owncast/owncast

[Service]
Type=simple
User=bitriver
Group=bitriver
EnvironmentFile=-/etc/bitriver/bitriver.env
ExecCondition=/usr/local/libexec/bitriver/owncast-enabled.sh
ExecStart=/usr/local/libexec/bitriver/start-owncast.sh
Restart=on-failure
RestartSec=2
StartLimitIntervalSec=120
StartLimitBurst=6
NoNewPrivileges=yes
ReadWritePaths=/var/lib/owncast /data/recordings

[Install]
WantedBy=bitriver.target
