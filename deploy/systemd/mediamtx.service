[Unit]
Description=MediaMTX ingest and routing service
After=network-online.target bitriver-bootstrap.service
Requires=bitriver-bootstrap.service
PartOf=bitriver.target

[Service]
Type=simple
User=bitriver
Group=bitriver
EnvironmentFile=-/etc/bitriver/bitriver.env
ExecStart=/usr/local/libexec/bitriver/start-mediamtx.sh
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bitriver

[Install]
WantedBy=bitriver.target
