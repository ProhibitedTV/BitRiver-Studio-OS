# EXPERIMENTAL ISO installer environment, deliberately separate from the
# production BitRiver bootc payload. Keep Fedora aligned with the locked
# base in deploy/image/releases.lock.json.
ARG FEDORA_BOOTC_IMAGE=quay.io/fedora/fedora-bootc@sha256:21be546e96dd831f5c92ecd0c84ea54205b2659a1724d1efa0b24ba465bc1556
FROM ${FEDORA_BOOTC_IMAGE}

# Fedora Anaconda and generic-iso boot requirements. The bare "anaconda"
# metapackage is NOT proof that the Fedora 44 graphical Web UI and an
# actual browser are present. Install both explicitly in the live ISO.
# Package versions are not snapshot-locked; this remains experimental.
RUN dnf -y install \
      anaconda anaconda-webui firefox anaconda-install-img-deps anaconda-dracut \
      dracut-config-generic dracut-network dracut-live \
      grub2-efi-x64-cdboot grub2-common grub2-pc-modules \
      plymouth default-fonts-core-sans default-fonts-other-sans \
      google-noto-sans-cjk-fonts net-tools xdpyinfo xwininfo \
      xorrisofs squashfs-tools implantisomd5 \
      podman python3 jq \
    && dnf clean all

# Fail at build time if the installer would have a display server but no
# browser-based Anaconda frontend. Do not rely on weak RPM dependencies.
RUN rpm -q anaconda-webui firefox xdpyinfo xwininfo \
    && test -x /usr/libexec/anaconda/webui-desktop \
    && command -v firefox && command -v xdpyinfo && command -v xwininfo

# The generic Fedora profile selects Slitherer (Chromium), which exited when
# launched as root in the actual ISO smoke. Choose Firefox WITHOUT disabling
# Chromium's sandbox. Restrict this override to the live installer image.
COPY deploy/iso/99-bitriver-browser.conf /etc/anaconda/conf.d/99-bitriver-browser.conf
RUN set -eux; \
    grep -Fxq 'webui_web_engine = firefox' /etc/anaconda/conf.d/99-bitriver-browser.conf; \
    useradd --system --create-home \
      --home-dir /var/lib/bitriver-installer-browser \
      --shell /usr/bin/bash bitriver-installer; \
    test "$(id -u bitriver-installer)" -ne 0; \
    browser_user="$(grep '/usr/bin/bash' /etc/passwd | grep -v '^root' | cut -d: -f1 | head -n 1)"; \
    test "$browser_user" = bitriver-installer

# New image-builder generic-iso requires UEFI boot media in the bootc image.
RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi
COPY deploy/iso/iso.yaml /usr/lib/image-builder/bootc/iso.yaml
COPY deploy/iso/interactive-defaults.ks /usr/share/anaconda/interactive-defaults.ks
# Installer-only diagnostic channel. Never copied to the BitRiver bootc payload.
COPY deploy/iso/serial-boot-diagnostics.conf /etc/systemd/journald.conf.d/90-bitriver-installer-serial.conf
# Read-only, live-ISO-only serial probe for web browser/compositor diagnosis.
# Does not modify partitions or require a network connection.
COPY deploy/iso/iso-browser-probe.sh /usr/libexec/bitriver/iso-browser-probe.sh
COPY deploy/iso/iso-browser-probe.service /usr/lib/systemd/system/bitriver-iso-browser-probe.service
RUN chmod 0755 /usr/libexec/bitriver/iso-browser-probe.sh \
    && mkdir -p /etc/systemd/system/anaconda.target.wants \
    && ln -sf /usr/lib/systemd/system/bitriver-iso-browser-probe.service \
      /etc/systemd/system/anaconda.target.wants/bitriver-iso-browser-probe.service

# Adapt the Fedora bootc base to boot Anaconda, never the BitRiver service
# target. The installer is interactive, not a preseeded disk-wiping image.
RUN set -eux; \
    echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd; \
    echo "install::14438:0:99999:7:::" >> /etc/shadow; \
    passwd -d root; \
    mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives; \
    if [ -d /usr/share/dnf5/repos.d ]; then \
      mv /usr/share/dnf5/repos.d /etc/anaconda.repos.d; \
    else \
      mv /etc/yum.repos.d /etc/anaconda.repos.d; \
    fi; \
    ln -sf /usr/lib/systemd/system/anaconda.target /etc/systemd/system/default.target; \
    rm -f /usr/lib/systemd/system-generators/systemd-gpt-auto-generator; \
    ln -sf /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service; \
    mkdir -p "$(realpath /root)" /usr/lib/systemd/logind.conf.d; \
    printf '[Login]\nReserveVT=2\n' > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

# Anaconda and dmsquash-live are required inside the initramfs for an ISO
# to boot into the installer rather than the installed BitRiver appliance.
RUN set -eux; \
    kver="$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | head -n 1)"; \
    test -n "$kver"; \
    DRACUT_NO_XATTR=1 dracut --force --zstd --no-hostonly \
      --add "anaconda livenet dmsquash-live" \
      "/usr/lib/modules/$kver/initramfs.img" "$kver"

# Anaconda may launch PipeWire as root in the installer environment only.
RUN mkdir -p /etc/systemd/user/pipewire.service.d /etc/systemd/user/pipewire.socket.d \
    && printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.service.d/allowroot.conf \
    && printf '[Unit]\nConditionUser=\n' > /etc/systemd/user/pipewire.socket.d/allowroot.conf
